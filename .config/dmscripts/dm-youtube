#!/usr/bin/env bash
set -euo pipefail
source $HOME/.config/dmscripts/config/config

play_yt() {
    read -r -p "Paste YouTube link: " url
    if [ -n "$url" ]; then
        unshare -U -m --map-root-user bash -c "mount --bind /dev/null /etc/hosts && mpv '$url'"
    fi
}
export -f play_yt

download_yt() {
    read -r -p "Paste YouTube link to download: " url
    if [ -n "$url" ]; then
        unshare -U -m --map-root-user bash -c "mount --bind /dev/null /etc/hosts && yt-dlp --concurrent-fragments 4 -P '$HOME/Downloads' '$url'"
        read -r -p "Press any key to exit..." -n 1
    fi
}
export -f download_yt

choice=$(printf 'Watch Video\nDownlaod Video\nExit' | ${DMENU} 'Youtube:' "$@")
if [ "$choice" ]; then
    case "${choice}" in
        'Watch Video')
            alacritty -e bash -c 'play_yt'
        ;;
        'Downlaod Video')
            alacritty -e bash -c 'download_yt'
        ;;
        'Exit')
            echo "Program terminated." && exit 0
        ;;
    esac
else
    echo "Program terminated." && exit 0
fi
